# ── Google Maps — Frontend key ─────────────────────────────────────────────────
# Enable on this key: Maps JavaScript API, Maps Static API,
# Street View Static API (for place photos without Places API New).
# Optional: set NEXT_PUBLIC_PLACES_API_NEW=1 after enabling Places API (New).
# Add HTTP referrer restriction: localhost:3000/* (dev) and your production domain
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_frontend_maps_api_key_here
# Server-side Routes API + photo proxy (recommended): IP-restricted key with
# Routes API, Places API + Maps Static API enabled.
# Routes API must be enabled in Google Cloud Console:
# https://console.cloud.google.com/apis/library/routes.googleapis.com
GOOGLE_MAPS_SERVER_KEY=your_server_maps_api_key_here
# NEXT_PUBLIC_PLACES_API_NEW=1

# ── Backend ────────────────────────────────────────────────────────────────────
# ADK API server URL (local dev: http://localhost:8000)
ADK_BASE_URL=http://localhost:8000
ADK_APP_NAME=hodari

# ── Voice (Gemini speech-to-text + text-to-speech) ──────────────────────────────
# Used ONLY by the server-side voice routes (/api/voice/transcribe + /api/voice/speak);
# credentials are never exposed to the browser. Pick ONE of the two paths below.
#
# Path 1 — Vertex AI (RECOMMENDED): billed through Google Cloud Billing, so it draws
# on your Cloud credits / the same project the agents already use. Auth is ADC
# (run once: gcloud auth application-default login). The AI Studio "prepay wallet"
# is NOT used here, so depleted AI Studio credits do not matter.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your_project_id_here
# Gemini 2.5 voice models are served regionally (NOT from "global"); keep a region:
GEMINI_VOICE_LOCATION=us-central1
#
# Path 2 — Developer API key (AI Studio). Has its own prepay wallet, separate from
# Cloud credits. Leave GOOGLE_GENAI_USE_VERTEXAI unset/false to use this.
# GEMINI_API_KEY=your_gemini_api_key_here
#
# Optional model/voice overrides (both paths):
# GEMINI_STT_MODEL=gemini-2.5-flash
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore   # other voices: Puck, Charon, Aoede, Fenrir, Leda, Orus, Zephyr
