# .env.example — copy to .env and fill in your values
# NEVER commit the real .env to git

# ── MongoDB Atlas ──────────────────────────────────────────────────────────────
# Read-write user (hodari_rw) — NOT the Atlas admin account
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI = mongodb+srv://admin:123@cluster0.kil3kqm.mongodb.net/hodari
# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Embedding model (Phase 2) ──────────────────────────────────────────────────
# EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-...
