# ── MongoDB Atlas ──────────────────────────────────────────────────────────────
# Read-write user (hodari_rw) — NOT the Atlas admin account
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI = mongodb+srv://admin:123@cluster0.kil3kqm.mongodb.net/hodari
# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000


GEMINI_API_KEY=AIzaSyDZsQf-_ZjD0Dy2v5cq2iETVmQKQVAsBM4
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Local dev only: Python on this machine cannot verify TLS certs (VPN/proxy)
MONGODB_TLS_ALLOW_INVALID_CERTIFICATES=true
HTTPS_ALLOW_INVALID_CERTIFICATES=true

