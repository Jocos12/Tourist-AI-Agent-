# ── Gemini via Vertex AI (uses your Google Cloud credits) ──────────────────────
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Your Google Cloud project ID (NOT the display name).
# Find it at console.cloud.google.com — shown in parentheses in the top bar.
GOOGLE_CLOUD_PROJECT=your_project_id_here

# Vertex AI region. Keep this "global": Gemini 3.x models are served only from
# the global endpoint — regional endpoints (e.g. us-central1) return 404 NOT_FOUND.
GOOGLE_CLOUD_LOCATION=global

# ── Authentication (pick ONE) ───────────────────────────────────────────────────
# Option A — your Google account via gcloud (easiest for local dev):
#   Run once in terminal: gcloud auth application-default login
#   Install gcloud if needed: winget install Google.CloudSDK
#   Leave GOOGLE_APPLICATION_CREDENTIALS unset.
#
# Option B — service account JSON key file (no gcloud needed):
#   Cloud Console → IAM → Service Accounts → hodari-gemini → Keys → Add Key → JSON
#   Download the file, then set the path below:
# GOOGLE_APPLICATION_CREDENTIALS=C:\Users\User\Documents\Map_Me\agents\hodari-gemini-key.json

# NOTE: The Gemini API key you created in Cloud Console is NOT used here.
# Vertex AI authenticates via your Google account (ADC) or a service account key file.
# That key will be used later when deploying to Cloud Run.

# Model to use for all agents.
GEMINI_MODEL=gemini-3.5-flash

# ── Google Maps — Backend key ───────────────────────────────────────────────────
# The API key you created in Cloud Console restricted to Maps Grounding Lite API.
# No restrictions needed on the application type (server-side key).
GOOGLE_MAPS_API_KEY=your_backend_maps_api_key_here

# ── MongoDB Atlas ───────────────────────────────────────────────────────────────
# Connection string from Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=hodari

# ── MongoDB MCP Server ──────────────────────────────────────────────────────
# Start the MCP server first (see CLAUDE.md dev commands), then set this URL.
# The MCP server reads MONGODB_URI above as MDB_MCP_CONNECTION_STRING.
MONGODB_MCP_URL=http://localhost:3100/mcp
